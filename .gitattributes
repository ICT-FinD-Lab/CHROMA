# Keep source and documentation line endings consistent across platforms.
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.json text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
requirements.txt text eol=lf
LICENSE text eol=lf

assets/groups/*.npy binary
assets/splits/*.npz binary

# The verifier checks these files byte for byte, including line endings.
assets/manifest.json -text !eol
configs/chroma.json -text !eol
configs/main_table.json -text !eol
results/controls_per_seed.csv -text !eol
results/main_table_per_seed.csv -text !eol
